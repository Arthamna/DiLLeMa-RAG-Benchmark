FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN uv export --frozen --no-dev --extra retrieval --no-emit-project --no-hashes --prune torch -o /tmp/requirements.txt \
    && uv pip install --system --no-cache 'torch==2.13.0+cpu' --index-url https://download.pytorch.org/whl/cpu \
    && uv pip install --system --no-cache -r /tmp/requirements.txt \
    && uv pip install --system --no-cache --no-deps . \
    && python -c "import rag_benchmark; import rag_benchmark.techniques.retro.retrieval_service"
ENV PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false BENCHMARK_IMAGE_VERSION=0.3.0
CMD ["python", "-m", "rag_benchmark.techniques.retro.retrieval_service", "--host", "0.0.0.0", "--port", "50051"]
