FROM nvidia/cuda:13.2.1-cudnn-runtime-ubuntu24.04
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates zlib1g && rm -rf /var/lib/apt/lists/*
ENV VIRTUAL_ENV=/opt/venv
RUN uv venv "$VIRTUAL_ENV" --python /usr/bin/python3
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN uv export --frozen --no-dev --extra inference --no-emit-project --no-hashes --prune torch -o /tmp/requirements.txt \
    && uv pip install --python "$VIRTUAL_ENV/bin/python" --no-cache 'torch==2.13.0+cu132' --index-url https://download.pytorch.org/whl/cu132 \
    && uv pip install --python "$VIRTUAL_ENV/bin/python" --no-cache -r /tmp/requirements.txt \
    && uv pip install --python "$VIRTUAL_ENV/bin/python" --no-cache --no-deps . \
    && "$VIRTUAL_ENV/bin/python" -c "import rag_benchmark; import rag_benchmark.techniques.retro.inference_service"
ENV PYTHONUNBUFFERED=1 RETRO_REQUIRE_CUDA=1 TOKENIZERS_PARALLELISM=false BENCHMARK_IMAGE_VERSION=0.3.0-cu132
CMD ["/opt/venv/bin/python", "-m", "rag_benchmark.techniques.retro.inference_service", "--host", "0.0.0.0", "--port", "50052"]
