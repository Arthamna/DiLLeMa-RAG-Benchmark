# Absolute snapshot directory, not the models--... cache parent directory.
# Example: /home/user/.cache/huggingface/hub/models--Qwen--Qwen2.5-0.5B-Instruct/snapshots/<commit>
HF_MODEL_NAME=/absolute/path/to/huggingface/snapshot
HF_QUANTIZATION=4bit
HF_TRUST_REMOTE_CODE=false
HF_MAX_INPUT_TOKENS=4096
HF_MAX_NEW_TOKENS=768

# OpenAI-compatible generator. The benchmark YAML selects this backend explicitly.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Read by `dillema serve` (flags override these).
LLM_MODEL=openrouter/free
LLM_MODEL_SOURCE=openrouter/free
# Caps chat completion so small models cannot stream forever.
LLM_MAX_TOKENS=768

RAG_DEVICE=auto
EMBED_BATCH_SIZE=32
RERANK_BATCH_SIZE=16
LOG_LEVEL=INFO
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# EMBED_MODEL_NAME=intfloat/multilingual-e5-base
# RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3

