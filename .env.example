# Absolute snapshot directory, not the models--... cache parent directory.
# Example: /home/user/.cache/huggingface/hub/models--Qwen--Qwen2.5-0.5B-Instruct/snapshots/<commit>
HF_MODEL_NAME=/absolute/path/to/huggingface/snapshot
HF_QUANTIZATION=4bit
HF_TRUST_REMOTE_CODE=false
HF_MAX_INPUT_TOKENS=4096
HF_MAX_NEW_TOKENS=128

# OpenAI-compatible generator. The benchmark YAML selects this backend explicitly.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Read by `dillema serve` (flags override these).
LLM_MODEL=openrouter/free
LLM_MODEL_SOURCE=openrouter/free
# Caps chat completion so small models cannot stream forever.
LLM_MAX_TOKENS=128

# Host paths mounted by Docker Compose.
RETRO_MODEL_DIR=./models
RETRO_ONNX_DIR=./artifacts/onnx
RETRO_INDEX_DIR=./artifacts/indexes
HF_CACHE_DIR=./artifacts/huggingface
# Conservative FP32 parity tolerances for CUDA/ONNX kernels; token argmax must still match.
RETRO_ONNX_ENCODER_ATOL=0.002
RETRO_ONNX_DECODER_ATOL=0.002
# ONNX tetap di GPU; model PyTorch hanya dipakai untuk bootstrap cache di CPU.
RETRO_BOOTSTRAP_DEVICE=cpu
# Hindari arena CUDA ONNX membulatkan pertumbuhan buffer ke pangkat dua.
RETRO_ORT_ARENA_EXTEND_STRATEGY=kSameAsRequested

RAG_DEVICE=auto
EMBED_BATCH_SIZE=8
RERANK_BATCH_SIZE=4
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
LOG_LEVEL=INFO
# Optional: avoid sending a cached/expired token when downloading public models.
# HF_HUB_DISABLE_IMPLICIT_TOKEN=1
# HF_HOME=/home/user/.cache/huggingface
# HF_HUB_DOWNLOAD_TIMEOUT=60
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# EMBED_MODEL_NAME=intfloat/multilingual-e5-base
# RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
